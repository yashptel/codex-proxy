# ── Domain routing (Traefik / Dokploy) ───────────────────────────────
# Public hostname your apps will call. Create this DNS record and point it
# at your Dokploy host (or your Cloudflare Tunnel) BEFORE deploying.
DOMAIN=codex.example.com

# ── codex-proxy runtime ───────────────────────────────────────────────
PORT=8080

# Mac Mini is Apple Silicon, so the container runs linux/arm64.
# Only switch CODEX_ARCH to x64 if the image runs emulated (see README).
CODEX_PLATFORM=linux
CODEX_ARCH=arm64

# Optional: paste a ChatGPT JWT to SKIP the interactive OAuth login.
# This is the reliable path on a headless/remote host. Leave empty to log
# in through the web dashboard at https://${DOMAIN} instead.
CODEX_JWT_TOKEN=

# ── Optional: Ollama-compatible bridge (off by default) ───────────────
# OLLAMA_BRIDGE_ENABLED=true
# OLLAMA_BRIDGE_HOST=0.0.0.0
# OLLAMA_BRIDGE_PORT=11434
